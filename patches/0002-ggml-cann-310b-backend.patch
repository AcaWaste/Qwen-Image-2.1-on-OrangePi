+/**
+ * @brief Computes a 2D convolution on the NPU.
+ *
+ * ggml_conv_2d_direct() hands over three tensors whose ggml layouts land on the
+ * aclnn layouts once ggml_cann_create_tensor() reverses `ne` and `nb`, so no
+ * permutation is required:
+ *
+ *   src[0] kernel  ggml [KW, KH, IC, OC] -> aclnn weight (OC, IC, KH, KW)
+ *   src[1] input   ggml [ W,  H,  C,  N] -> aclnn input  ( N,  C,  H,  W)
+ *   dst            ggml [OW, OH, OC,  N] -> aclnn output ( N, OC, OH, OW)
+ *
+ * aclnnConvolution() orders the two spatial dimensions as (H, W) while ggml
+ * orders them as (ne[0] = W, ne[1] = H), so stride, padding and dilation are
+ * handed over reversed.
+ *
+ * [310B] Ascend310B1 only has Conv2D_5HD_{FP16,BF16} kernels, hence the FP16
+ * scratch buffers around the cube call. The destination type is restored
+ * afterwards, so callers still observe the F32 result ggml expects.
+ *
+ * @param ctx The CANN backend context.
+ * @param dst The destination tensor holding the convolution result.
+ */
+void ggml_cann_conv2d(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    ggml_tensor * srcKernel = dst->src[0];
+    ggml_tensor * srcInput  = dst->src[1];
+
+    const int32_t * piParams = (const int32_t *) dst->op_params;
+
+    /* ggml stores (s0, s1, p0, p1, d0, d1) for (W, H); aclnn wants (H, W). */
+    int64_t strideVal[2] = { piParams[1], piParams[0] };
+    int64_t padVal[2]    = { piParams[3], piParams[2] };
+    int64_t dilVal[2]    = { piParams[5], piParams[4] };
+
+    acl_int_array_ptr stride   = ggml_cann_create_int_array(strideVal, 2);
+    acl_int_array_ptr padding  = ggml_cann_create_int_array(padVal, 2);
+    acl_int_array_ptr dilation = ggml_cann_create_int_array(dilVal, 2);
+
+    /* ggml_conv_2d_direct() is not the depthwise entry point, so no grouping. */
+    int64_t groups      = 1;
+    bool    transposed  = false;
+    int8_t  cubeMathType = 0;
+
+    ggml_cann_pool_alloc tInputAlloc(ctx.pool());
+    ggml_cann_pool_alloc tKernelAlloc(ctx.pool());
+    ggml_cann_pool_alloc tResultAlloc(ctx.pool());
+
+    void * pvInput  = NULL;
+    void * pvKernel = NULL;
+    void * pvResult = NULL;
+
+    acl_tensor_ptr aclInput  = ggml_cann_cast_to_fp16(ctx, srcInput, tInputAlloc, &pvInput, ACL_FORMAT_NCHW);
+    acl_tensor_ptr aclKernel = ggml_cann_cast_to_fp16(ctx, srcKernel, tKernelAlloc, &pvKernel, ACL_FORMAT_NCHW);
+
+    acl_tensor_ptr aclResult;
+    if (dst->type == GGML_TYPE_F16) {
+        aclResult = ggml_cann_create_tensor(dst, dst->ne, dst->nb, GGML_MAX_DIMS, ACL_FORMAT_NCHW);
+    } else {
+        size_t aHalfNb[GGML_MAX_DIMS];
+        for (int i = 0; i < GGML_MAX_DIMS; i++) {
+            aHalfNb[i] = dst->nb[i] / 2;
+        }
+        pvResult  = tResultAlloc.alloc(ggml_nbytes(dst) / 2);
+        aclResult = ggml_cann_create_tensor(pvResult, ACL_FLOAT16, sizeof(uint16_t), dst->ne, aHalfNb, GGML_MAX_DIMS,
+                                            ACL_FORMAT_NCHW);
+    }
+
+    GGML_CANN_CALL_ACLNN_OP(ctx, Convolution, aclInput.get(), aclKernel.get(), nullptr, stride.get(), padding.get(),
+                            dilation.get(), transposed, padding.get(), groups, aclResult.get(), cubeMathType);
+
+    if (dst->type != GGML_TYPE_F16) {
+        /* [310B] move the FP16 cube result back into the F32 ggml destination. */
+        acl_tensor_ptr aclDst = ggml_cann_create_tensor(dst, dst->ne, dst->nb, GGML_MAX_DIMS, ACL_FORMAT_NCHW);
+        aclnn_cast(ctx, aclResult.get(), aclDst.get(), ggml_cann_type_mapping(dst->type));
+    }
+}

+/**
+ * @brief Exposes a ggml tensor as an FP16 ACL tensor, casting when necessary.
+ *
+ * Ascend310B1 only ships FP16 cube kernels, so aclnnConvolution() has to be fed
+ * ACL_FLOAT16 operands even though ggml hands over F32 activations. When `src`
+ * already is F16 the original buffer is reused and nothing is allocated.
+ *
+ * The scratch strides are obtained by halving the real byte strides instead of
+ * walking `ne`, so a layout that is not contiguous survives the round trip.
+ *
+ * @param ctx        The CANN backend context.
+ * @param src        Source tensor to expose as FP16.
+ * @param alloc      Pool allocator owning the scratch buffer. It has to outlive
+ *                   the returned tensor.
+ * @param ppvScratch Receives the scratch pointer so the caller can tell whether
+ *                   a buffer was taken. Set to nullptr when no cast was needed.
+ * @param format     ACL format to declare for the created tensors.
+ * @return ACL tensor referring to FP16 data.
+ */
+static acl_tensor_ptr ggml_cann_cast_to_fp16(ggml_backend_cann_context & ctx,
+                                             ggml_tensor *               src,
+                                             ggml_cann_pool_alloc &      alloc,
+                                             void **                     ppvScratch,
+                                             aclFormat                   format) {
+    if (src->type == GGML_TYPE_F16) {
+        return ggml_cann_create_tensor(src, src->ne, src->nb, GGML_MAX_DIMS, format);
+    }
+
+    size_t aHalfNb[GGML_MAX_DIMS];
+    for (int i = 0; i < GGML_MAX_DIMS; i++) {
+        aHalfNb[i] = src->nb[i] / 2;
+    }
+
+    *ppvScratch = alloc.alloc(ggml_nbytes(src) / 2);
+
+    acl_tensor_ptr aclSrc = ggml_cann_create_tensor(src, src->ne, src->nb, GGML_MAX_DIMS, format);
+    acl_tensor_ptr aclDst = ggml_cann_create_tensor(*ppvScratch, ACL_FLOAT16, sizeof(uint16_t), src->ne, aHalfNb,
+                                                    GGML_MAX_DIMS, format);
+    aclnn_cast(ctx, aclSrc.get(), aclDst.get(), ACL_FLOAT16);
+
+    return aclDst;
+}

+/**
+ * @brief Repeat (tile) for the Ascend 310B1, composed from Cat.
+ *
+ * Two candidates were tried first and both are dead ends on this part:
+ * aclnnRepeat has no ascend310b kernel at all, and aclnnExpand fails kernel
+ * selection with "Cannot find bin of op Expand, integral key
+ * 0/1/|float/ND/int64/ND/float/ND" - the three shipped Expand binaries are
+ * not keyed on the int64 shape tensor aclnn feeds. Cat does work, and a
+ * repeat is exactly "concatenate the copies with each other", so it is
+ * rebuilt from Cat here.
+ *
+ * A ggml repeat may grow several dimensions at once, so the node is
+ * decomposed one growing dimension at a time, in ascending order.  Every
+ * intermediate stage is a tightly packed tensor of the stage shape - never
+ * a strided view into a larger buffer - which is what makes the higher
+ * dimensions come out right: cat along dim d of a packed tensor simply
+ * yields the packed stage result.  One Cat takes all `factor` copies as
+ * inputs, so a stage costs exactly one kernel whatever the factor; a kernel
+ * launch is milliseconds on this part and the DiT repeats the same
+ * broadcast hundreds of times per step.
+ *
+ * Scratch is only needed by the intermediate stages, so a repeat that
+ * grows one dimension - the common case - allocates nothing at all.  Two
+ * buffers of nbytes(dst) cover up to four growing dimensions, because
+ * consecutive stages alternate between them.
+ *
+ * @param ctx The CANN backend context.
+ * @param dst The destination tensor; src[0] is the input.
+ */
+static void ggml_cann_repeat_310b(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    ggml_tensor * src = dst->src[0];
+
+    const size_t      typeSize = ggml_type_size(src->type);
+    const aclDataType aclType  = ggml_cann_type_mapping(src->type);
+
+    int nGrow = 0;
+    for (int i = 0; i < GGML_MAX_DIMS; i++) {
+        if (dst->ne[i] != src->ne[i]) {
+            nGrow++;
+        }
+    }
+
+    if (nGrow == 0) {
+        /* ggml_ext_full(ctx, value, 1, 1, 1, 1) emits repeat(one, 1,1,1,1):
+         * a repeat with nothing to repeat, i.e. a 4-byte copy.  The DiT has
+         * one of these at the head of nearly every runner segment, and
+         * leaving them on the CPU split the graph around each of them. */
+        acl_tensor_ptr acl_src = ggml_cann_create_tensor(src);
+        acl_tensor_ptr acl_dst = ggml_cann_create_tensor(dst);
+        GGML_CANN_CALL_ACLNN_OP(ctx, InplaceCopy, acl_dst.get(), acl_src.get());
+        return;
+    }
+
+    std::unique_ptr<ggml_cann_pool_alloc> bufA;
+    std::unique_ptr<ggml_cann_pool_alloc> bufB;
+    if (nGrow > 1) {
+        bufA.reset(new ggml_cann_pool_alloc(ctx.pool(), ggml_nbytes(dst)));
+        bufB.reset(new ggml_cann_pool_alloc(ctx.pool(), ggml_nbytes(dst)));
+    }
+    bool nextIsA = true;
+
+    /* The stage tensor is packed, so its strides follow from its shape. */
+    int64_t stageNe[GGML_MAX_DIMS];
+    size_t  stageNb[GGML_MAX_DIMS];
+    memcpy(stageNe, src->ne, sizeof(stageNe));
+    stageNb[0] = typeSize;
+    for (int i = 1; i < GGML_MAX_DIMS; i++) {
+        stageNb[i] = stageNb[i - 1] * (size_t) stageNe[i - 1];
+    }
+    /* The first stage is the op input, whose own strides decide the
+     * descriptor; every later stage is packed, so the strides built above
+     * describe it. */
+    void * stagePtr   = src->data;
+    bool   stageIsSrc = true;
+
+    for (int dim = 0; dim < GGML_MAX_DIMS; dim++) {
+        const int64_t factor = dst->ne[dim] / src->ne[dim];
+        if (factor == 1) {
+            continue;
+        }
+
+        bool last = true;
+        for (int j = dim + 1; j < GGML_MAX_DIMS; j++) {
+            if (dst->ne[j] != src->ne[j]) {
+                last = false;
+                break;
+            }
+        }
+
+        int64_t outNe[GGML_MAX_DIMS];
+        memcpy(outNe, stageNe, sizeof(outNe));
+        outNe[dim] = stageNe[dim] * factor;
+        size_t outNb[GGML_MAX_DIMS];
+        outNb[0] = typeSize;
+        for (int i = 1; i < GGML_MAX_DIMS; i++) {
+            outNb[i] = outNb[i - 1] * (size_t) outNe[i - 1];
+        }
+
+        /* The last stage writes the op output, whose own layout decides the
+         * descriptor; a scratch stage uses the packed one built above. */
+        acl_tensor_ptr tOut;
+        void *         outPtr = dst->data;
+        if (last) {
+            tOut = ggml_cann_create_tensor(dst);
+        } else {
+            outPtr  = nextIsA ? bufA->get() : bufB->get();
+            nextIsA = !nextIsA;
+            tOut    = ggml_cann_create_tensor(outPtr, aclType, typeSize, outNe, outNb, GGML_MAX_DIMS);
+        }
+
+        /* All `factor` copies are the same stage.  The list owns them:
+         * aclCreateTensorList takes over the aclTensor handles, so ownership
+         * must be released here -- keeping them alive would double free
+         * (acl_tensor.h, ggml_cann_create_tensor_list). */
+        std::vector<aclTensor *> copies;
+        copies.reserve((size_t) factor);
+        for (int64_t k = 0; k < factor; k++) {
+            if (stageIsSrc) {
+                copies.push_back(ggml_cann_create_tensor(src).release());
+            } else {
+                copies.push_back(
+                    ggml_cann_create_tensor(stagePtr, aclType, typeSize, stageNe, stageNb, GGML_MAX_DIMS).release());
+            }
+        }
+        acl_tensor_list_ptr list(aclCreateTensorList(copies.data(), (uint64_t) copies.size()));
+        aclnn_concat(ctx, list.get(), tOut.get(), GGML_MAX_DIMS - 1 - dim);
+
+        if (last) {
+            return;
+        }
+        memcpy(stageNe, outNe, sizeof(stageNe));
+        memcpy(stageNb, outNb, sizeof(stageNb));
+        stagePtr   = outPtr;
+        stageIsSrc = false;
+    }
+}
+#endif

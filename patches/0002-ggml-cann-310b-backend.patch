+#ifdef ASCEND_310B
+/**
+ * @brief RMSNorm composed from vector primitives for the Ascend 310B1.
+ *
+ * The 310B op package ships only RmsNormQuant; the plain RmsNorm kernel that
+ * ggml_cann_rms_norm() calls does not exist there. The arithmetic is
+ *     y = x * rsqrt(mean(x * x, dim = ne0) + eps)
+ * which is exactly what the reference implementation computes, so it can be
+ * rebuilt from Mul / Mean / Adds / Rsqrt, all of which do have 310B kernels.
+ * Work is done in F32 regardless of the input type, matching the F32
+ * accumulation of the CPU reference; the result is cast back at the end.
+ *
+ * @param ctx The CANN backend context.
+ * @param dst The destination tensor; src[0] is the input, op_params holds eps.
+ */
+static void ggml_cann_rms_norm_310b(ggml_backend_cann_context & ctx, ggml_tensor * dst) {
+    ggml_tensor * src = dst->src[0];
+
+    const int64_t n      = ggml_nelements(src);
+    const int64_t n_rows = src->ne[1] * src->ne[2] * src->ne[3];
+
+    ggml_cann_pool_alloc x32_alloc(ctx.pool(), (size_t) n * sizeof(float));
+    ggml_cann_pool_alloc y_alloc(ctx.pool(), (size_t) n * sizeof(float));
+    ggml_cann_pool_alloc mean_alloc(ctx.pool(), (size_t) n_rows * sizeof(float));
+    ggml_cann_pool_alloc rstd_alloc(ctx.pool(), (size_t) n_rows * sizeof(float));
+
+    // One row per (ne1, ne2, ne3) position: [1, ne1, ne2, ne3] in ggml order,
+    // i.e. a trailing length-1 dimension in acl order, which Mul broadcasts.
+    int64_t row_ne[GGML_MAX_DIMS] = { 1, src->ne[1], src->ne[2], src->ne[3] };
+    size_t  row_nb[GGML_MAX_DIMS];
+    row_nb[0] = sizeof(float);
+    for (int i = 1; i < GGML_MAX_DIMS; i++) {
+        row_nb[i] = row_nb[i - 1] * (size_t) row_ne[i - 1];
+    }
+
+    // The temporaries are F32 whatever the input type is, so their strides
+    // come from a plain contiguous F32 layout and not from src->nb.
+    int64_t full_ne[GGML_MAX_DIMS];
+    size_t  full_nb[GGML_MAX_DIMS];
+    full_nb[0] = sizeof(float);
+    for (int i = 0; i < GGML_MAX_DIMS; i++) {
+        full_ne[i] = src->ne[i];
+        if (i > 0) {
+            full_nb[i] = full_nb[i - 1] * (size_t) full_ne[i - 1];
+        }
+    }
+
+    acl_tensor_ptr acl_src  = ggml_cann_create_tensor(src);
+    acl_tensor_ptr acl_dst  = ggml_cann_create_tensor(dst);
+    acl_tensor_ptr acl_x32  = ggml_cann_create_tensor(x32_alloc.get(), ACL_FLOAT, sizeof(float), full_ne, full_nb,
+                                                       GGML_MAX_DIMS);
+    acl_tensor_ptr acl_y    = ggml_cann_create_tensor(y_alloc.get(), ACL_FLOAT, sizeof(float), full_ne, full_nb,
+                                                      GGML_MAX_DIMS);
+    acl_tensor_ptr acl_mean = ggml_cann_create_tensor(mean_alloc.get(), ACL_FLOAT, sizeof(float), row_ne, row_nb,
+                                                      GGML_MAX_DIMS);
+    acl_tensor_ptr acl_rstd = ggml_cann_create_tensor(rstd_alloc.get(), ACL_FLOAT, sizeof(float), row_ne, row_nb,
+                                                      GGML_MAX_DIMS);
+
+    float          oneValue = 1.0f;
+    float          eps;
+    memcpy(&eps, dst->op_params, sizeof(float));
+    acl_scalar_ptr one     = ggml_cann_create_scalar(&oneValue, ACL_FLOAT);
+    acl_scalar_ptr eps_sc  = ggml_cann_create_scalar(&eps, ACL_FLOAT);
+
+    // x32 = (float) x
+    if (src->type == GGML_TYPE_F32) {
+        GGML_CANN_CALL_ACLNN_OP(ctx, Muls, acl_src.get(), one.get(), acl_x32.get());
+    } else {
+        GGML_CANN_CALL_ACLNN_OP(ctx, Cast, acl_src.get(), ACL_FLOAT, acl_x32.get());
+    }
+
+    // mean = reduce_mean(x * x) over ne0, which is the last acl dimension
+    int64_t            mean_dim_data[1] = { GGML_MAX_DIMS - 1 };
+    acl_int_array_ptr  mean_dim         = ggml_cann_create_int_array(mean_dim_data, 1);
+    GGML_CANN_CALL_ACLNN_OP(ctx, Mul, acl_x32.get(), acl_x32.get(), acl_y.get());
+    GGML_CANN_CALL_ACLNN_OP(ctx, Mean, acl_y.get(), mean_dim.get(), true, ACL_FLOAT, acl_mean.get());
+
+    // rstd = rsqrt(mean + eps)
+    GGML_CANN_CALL_ACLNN_OP(ctx, InplaceAdds, acl_mean.get(), eps_sc.get(), one.get());
+    GGML_CANN_CALL_ACLNN_OP(ctx, Rsqrt, acl_mean.get(), acl_rstd.get());
+
+    // y = x32 * rstd (rstd broadcasts over ne0); acl_y is free again here
+    GGML_CANN_CALL_ACLNN_OP(ctx, Mul, acl_x32.get(), acl_rstd.get(), acl_y.get());
+
+    if (dst->type == GGML_TYPE_F32) {
+        GGML_CANN_CALL_ACLNN_OP(ctx, Muls, acl_y.get(), one.get(), acl_dst.get());
+    } else {
+        GGML_CANN_CALL_ACLNN_OP(ctx, Cast, acl_y.get(), ggml_cann_type_mapping(dst->type), acl_dst.get());
+    }
+}
+#endif

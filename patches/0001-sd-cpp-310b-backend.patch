+namespace {
+
+/**************************************************************************
+* Function name : DumpLatentIfRequested
+* Description   : Dump a Tensor<float> to <SD_DUMP_DIR>/<name>.bin so the
+*                 CANN0 and CPU numerical paths can be compared element-wise.
+*                 Layout: int64 ndim | int64 shape[ndim] | float32 payload.
+*                 No-op unless SD_DUMP_DIR is set.
+* Input         : name   - base file name, no extension
+*                 tensor - tensor to write
+* Return        : none
+* Others        : fopen/fwrite only; a failure to dump never aborts a run.
+* Mod date      Version  Author  Change
+* -----------------------------------------------
+* 2026/10/14    V1.0     -       created
+**************************************************************************/
+void DumpLatentIfRequested(const char* name, const sd::Tensor<float>& tensor) {
+    const char* dump_dir = std::getenv("SD_DUMP_DIR");
+    if (dump_dir == NULL || tensor.empty()) {
+        return;
+    }
+
+    char dump_path[512];
+    snprintf(dump_path, sizeof(dump_path), "%s/%s.bin", dump_dir, name);
+
+    FILE* dump_handle = std::fopen(dump_path, "wb");
+    if (dump_handle == NULL) {
+        LOG_ERROR("cannot open latent dump %s", dump_path);
+        return;
+    }
+
+    const int64_t elem_count = tensor.numel();
+    const int64_t dim_count  = tensor.dim();
+    std::fwrite(&dim_count, sizeof(dim_count), 1, dump_handle);
+    for (int64_t dim_size : tensor.shape()) {
+        std::fwrite(&dim_size, sizeof(dim_size), 1, dump_handle);
+    }
+    std::fwrite(tensor.data(), sizeof(float), static_cast<size_t>(elem_count), dump_handle);
+    std::fclose(dump_handle);
+
+    LOG_INFO("dumped %s: %lld elements, %lld dims", dump_path,
+             (long long) elem_count, (long long) dim_count);
+}
+
+}  // namespace
